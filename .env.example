# Local development database (docker-compose.yml)
DATABASE_URL=postgres://conveyor:conveyor@127.0.0.1:55433/conveyor?sslmode=disable

# Demo stack (compose-demo.yml). Generate real values with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
CONVEYOR_API_TOKEN=change-me-token
# Public hostname for automatic HTTPS; leave as localhost for a local CA.
DOMAIN=localhost
# Set to http://jaeger:4318 when running with --profile observability.
OTEL_EXPORTER_OTLP_ENDPOINT=
