    {
      "id": 2,
      "title": "Running with expired lease",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "conveyor_jobs_running_expired_lease"}]
    }
  ]
}
